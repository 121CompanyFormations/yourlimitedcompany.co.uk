# Optional: set to "/repo-name/" for project pages without a custom domain
VITE_BASE_PATH=./

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Google Search Console HTML tag verification content value
# Search Console → Settings / URL prefix → HTML tag → copy only the content="..." value
VITE_GSC_VERIFICATION=
